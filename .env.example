# ---------------------------------------------------------------------------
# Clinchec — local development environment
# Copy to `.env` at the repo root. docker-compose and all services read from it.
# ---------------------------------------------------------------------------

# --- Core infrastructure -----------------------------------------------------
POSTGRES_USER=clinchec
POSTGRES_PASSWORD=clinchec_dev_password
POSTGRES_DB=clinchec
DATABASE_URL=postgresql+asyncpg://clinchec:clinchec_dev_password@postgres:5432/clinchec
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Clinchec Scan -----------------------------------------------------------
SCAN_PORT=8001
SPACY_MODEL=en_core_web_sm
# Optional: swap in a licensed clinical model (e.g. en_core_sci_md from scispaCy)
SPACY_CLINICAL_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
JUSTIFICATION_ENABLED=false

# --- Clinchec Live -----------------------------------------------------------
LIVE_PORT=8002
PAYER_POLL_INTERVAL_MINUTES=360
PAYER_HTTP_TIMEOUT_SECONDS=30
PAYER_USER_AGENT=ClinchecLive/0.1 (+https://clinchec.com/bot)
AETNA_PORTAL_BASE_URL=https://www.aetna.com
BCBS_PORTAL_BASE_URL=https://www.bcbs.com
UHC_PORTAL_BASE_URL=https://www.uhcprovider.com

# --- Clinchec Forms ----------------------------------------------------------
FORMS_PORT=8003
FORMS_EXPORT_BUCKET=clinchec-dev-exports
AWS_REGION=us-east-1

# --- SMART on FHIR (Epic / Cerner) ------------------------------------------
# Register the app in the Epic App Orchard / Cerner Code console to obtain these.
FHIR_ISSUER=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_REDIRECT_URI=http://localhost:3000/api/auth/callback
FHIR_SCOPES=openid fhirUser launch patient/Patient.read patient/Condition.read patient/DocumentReference.read offline_access

# --- Web app -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SCAN_API_URL=http://localhost:8001
NEXT_PUBLIC_LIVE_API_URL=http://localhost:8002
NEXT_PUBLIC_FORMS_API_URL=http://localhost:8003
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-32-bytes-of-base64-entropy

# --- Development auth bypass -------------------------------------------------
# Creates a session WITHOUT authenticating against any EHR, so the Scan and
# Forms UI can be exercised without a registered SMART on FHIR client.
#
# This is an authentication bypass in an application that handles PHI.
#   * It is refused outright when NODE_ENV=production.
#   * The sign-in route returns 404 while it is off, so production never
#     advertises that the endpoint exists.
#   * Sessions it creates show a permanent warning banner and carry no usable
#     credential.
# Never set this in a deployed environment.
DEV_AUTH_BYPASS=false
