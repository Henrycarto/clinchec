{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    // The guard test runs on Node's native type stripping, which requires the
    // explicit .ts specifier on its import.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@clinchec/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@clinchec/fhir-client": ["../../packages/fhir-client/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}