{
  "family": "clinchec-migrate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::000000000000:role/clinchec-ecs-execution",
  "taskRoleArn": "arn:aws:iam::000000000000:role/clinchec-migrate-task",
  "containerDefinitions": [
    {
      "name": "clinchec-migrate",
      "image": "PLACEHOLDER_REPLACED_BY_CI",
      "essential": true,
      "command": ["python", "-m", "app.migrations"],
      "environment": [
        { "name": "SERVICE_NAME", "value": "clinchec-migrate" },
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "LOG_LEVEL", "value": "info" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:clinchec/database_url" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/clinchec-migrate",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
